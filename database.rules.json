{
  "rules": {
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)"
      }
    },
    "hub": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "chat": {
        ".read": "auth != null",
        "$mid": {
          ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 80"
        }
      },
      "sig": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          ".write": "auth != null && auth.uid === $to",
          "$mid": {
            ".write": "auth != null && (auth.uid === $to || (!data.exists() && newData.child('from').val() === auth.uid))"
          }
        }
      }
    }
  }
}
